# Copie para ~/.magicads/tokens/<cliente>.env e rode: chmod 600 nesse arquivo.
#
# UM ARQUIVO POR CLIENTE. Nao junte tudo num .env gigante: perder um arquivo
# nao pode ser perder a frota inteira.
#
# A unica regra do formato: a chave TEM que terminar em _META_TOKEN.
# O prefixo e livre, use o nome do cliente pra saber de quem e quando abrir.

ACME_META_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional, so pra voce lembrar de onde esse token veio:
# ACME_APP_ID=000000000000000
# ACME_BM_ID=000000000000000
# ACME_ACT=act_000000000000000
# ACME_PAGE=000000000000000
